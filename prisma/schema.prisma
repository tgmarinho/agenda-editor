generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  authId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs  Design[]
  orders   Order[]
  addresses Address[]
}

model Template {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  category       String   // feminina | masculina | profissional | elegante
  thumbnailUrl   String
  fullImageUrl   String
  suggestedLayout Json    // { namePosition: {x,y,fontSize,fontFamily,color}, logoPosition: {x,y,width} }
  price          Int      // centavos
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  designs  Design[]
}

model MioloType {
  id              String   @id @default(cuid())
  name            String   // Comercial | Classica | Juridica
  availableColors Json     // string[]
  description     String?
  createdAt       DateTime @default(now())

  agendaConfigs AgendaConfig[]
}

model SpiralColor {
  id        String   @id @default(cuid())
  name      String   // Prata, Dourado, Preto, etc.
  hexColor  String
  isActive  Boolean  @default(true)

  agendaConfigs AgendaConfig[]
}

model Design {
  id             String   @id @default(cuid())
  userId         String?
  templateId     String
  editorState    Json?    // Fabric.js canvas JSON
  userImageUrl   String?
  previewImageUrl String?
  exportImageUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?        @relation(fields: [userId], references: [id])
  template     Template     @relation(fields: [templateId], references: [id])
  agendaConfig AgendaConfig?
  order        Order?
}

model AgendaConfig {
  id               String   @id @default(cuid())
  designId         String   @unique
  mioloTypeId      String
  daysPerPage      Int      // 1 | 2
  calendarPosition String   // lateral | footer
  mioloColor       String
  spiralColorId    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  design      Design      @relation(fields: [designId], references: [id])
  mioloType   MioloType   @relation(fields: [mioloTypeId], references: [id])
  spiralColor SpiralColor @relation(fields: [spiralColorId], references: [id])
  order       Order?
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  designId       String      @unique
  agendaConfigId String      @unique
  addressId      String
  status         OrderStatus @default(PENDING_PAYMENT)
  totalAmount    Int         // centavos
  shippingAmount Int         // centavos
  paymentId      String?
  paymentMethod  String?
  paidAt         DateTime?
  trackingCode   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  design       Design       @relation(fields: [designId], references: [id])
  agendaConfig AgendaConfig @relation(fields: [agendaConfigId], references: [id])
  address      Address      @relation(fields: [addressId], references: [id])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}
